@{
    var pageTitle = ViewData["Title"] as string ?? "Energy Management";
    var currentPath = Context.Request.Path.Value ?? "/";
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f172a" />
    <title>@pageTitle · Energy Management</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (() => {
            const saved = localStorage.getItem("ems-theme");
            const theme = saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            document.documentElement.dataset.theme = theme;
        })();
    </script>
</head>
<body class="min-h-full bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
<div class="min-h-screen">
    <aside id="sidebar" class="sidebar fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col border-r border-slate-200 bg-white transition-transform dark:border-slate-800 dark:bg-slate-900 @(User.Identity?.IsAuthenticated == true ? "lg:translate-x-0" : "hidden")">
        <a asp-page="/Index" class="flex h-20 items-center gap-3 border-b border-slate-200 px-6 dark:border-slate-800">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-blue-600 text-white">
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2 4 14h7l-1 8 10-13h-7l0-7Z" stroke-linejoin="round"/></svg>
            </span>
            <span><span class="block text-sm font-bold tracking-wide">ENERGY<span class="text-blue-600">OS</span></span><span class="text-xs text-slate-500">Residential management</span></span>
        </a>
        <nav class="flex-1 space-y-7 overflow-y-auto px-4 py-7" aria-label="Main navigation">
            <div>
                <p class="nav-heading">Overview</p>
                <a asp-page="/Index" class="nav-link @(currentPath == "/" ? "nav-link-active" : "")">
                    <span class="nav-icon">▦</span> Dashboard
                </a>
            </div>
            <div>
                <p class="nav-heading">Monitoring</p>
                <a asp-page="/Devices/Index" class="nav-link @(currentPath.StartsWith("/Devices") ? "nav-link-active" : "")">
                    <span class="nav-icon">▣</span> Devices
                </a>
            </div>
            <div>
                <p class="nav-heading">Operations</p>
                <a asp-page="/Alerts/Index" class="nav-link @(currentPath.StartsWith("/Alerts") ? "nav-link-active" : "")">
                    <span class="nav-icon">◉</span> Alerts &amp; notifications
                </a>
            </div>
            <div>
                <p class="nav-heading">Management</p>
                <a asp-page="/Settings/Index" class="nav-link @(currentPath.StartsWith("/Settings") ? "nav-link-active" : "")">
                    <span class="nav-icon">⚙</span> Settings
                </a>
                <a asp-page="/Account/Profile" class="nav-link @(currentPath.StartsWith("/Account/Profile") ? "nav-link-active" : "")">
                    <span class="nav-icon">◉</span> Account security
                </a>
                @if (User.IsInRole("Administrator"))
                {
                    <a asp-page="/Households/Create" class="nav-link @(currentPath.StartsWith("/Households/Create") ? "nav-link-active" : "")">
                        <span class="nav-icon">＋</span> Create household
                    </a>
                    <a asp-page="/Households/Users" class="nav-link @(currentPath.StartsWith("/Households/Users") ? "nav-link-active" : "")">
                        <span class="nav-icon">♙</span> Household users
                    </a>
                }
            </div>
        </nav>
        <div class="border-t border-slate-200 p-4 dark:border-slate-800">
            <div class="rounded-xl bg-slate-50 p-3 dark:bg-slate-800/70">
                <p class="text-xs font-semibold text-slate-700 dark:text-slate-200">Monitoring status</p>
                <p class="mt-1 text-xs text-slate-500">Telemetry integration pending</p>
            </div>
            <p class="mt-4 px-2 text-xs text-slate-400">Energy Management System · v0.1</p>
        </div>
    </aside>

    <div class="@(User.Identity?.IsAuthenticated == true ? "lg:pl-64" : "")">
        <header class="@(User.Identity?.IsAuthenticated == true ? "sticky top-0 z-30 flex h-20 items-center justify-between border-b border-slate-200 bg-white/90 px-4 backdrop-blur md:px-8 dark:border-slate-800 dark:bg-slate-900/90" : "hidden")">
            <div class="flex min-w-0 items-center gap-3">
                <button id="sidebar-toggle" class="icon-button lg:hidden" type="button" aria-label="Open navigation">☰</button>
                <div class="min-w-0">
                    <p class="hidden text-xs text-slate-500 sm:block">Residential energy platform</p>
                    <h1 class="truncate text-base font-semibold">@pageTitle</h1>
                </div>
            </div>
            <div class="flex items-center gap-2 md:gap-3">
                @if (ViewData["Households"] is IReadOnlyList<HouseholdOption> households && households.Count > 0)
                {
                    <form method="get" class="hidden sm:block">
                        @if (Context.Request.Query.TryGetValue("search", out var search))
                        {
                            <input type="hidden" name="search" value="@search" />
                        }
                        <label class="sr-only" for="household-select">Selected household</label>
                        <select id="household-select" name="householdId" class="control-select" onchange="this.form.submit()">
                            @foreach (var household in households)
                            {
                                var selectedId = ViewData["SelectedHouseholdId"] as int?;
                                <option value="@household.Id" selected="@(selectedId == household.Id)">@household.Code · @household.Name</option>
                            }
                        </select>
                    </form>
                }
                <button id="theme-toggle" class="icon-button" type="button" aria-label="Toggle colour theme" title="Toggle theme">◐</button>
                <a asp-page="/Alerts/Index" class="icon-button relative" aria-label="Notifications" title="Notifications">
                    ♧
                    <span class="absolute right-1.5 top-1.5 h-2 w-2 rounded-full bg-amber-500"></span>
                </a>
                <span class="hidden max-w-40 truncate text-xs text-slate-500 md:block">@User.Identity?.Name</span>
                <form method="post" asp-page="/Account/Logout">
                    <button type="submit" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Sign out</button>
                </form>
            </div>
        </header>
        <main class="mx-auto max-w-[1600px] px-4 py-7 md:px-8 md:py-9 @(User.Identity?.IsAuthenticated == true ? "" : "min-h-screen")">
            @RenderBody()
        </main>
    </div>
</div>
<div id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-slate-950/50 lg:hidden"></div>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
