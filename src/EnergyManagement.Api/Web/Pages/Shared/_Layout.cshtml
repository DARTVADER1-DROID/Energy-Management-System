@{
    var pageTitle = ViewData["Title"] as string ?? "Energy Management";
    var currentPath = Context.Request.Path.Value ?? "/";
    var authenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#6d28d9" />
    <meta name="color-scheme" content="light dark" />
    <title>@pageTitle · EnergyOS</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (() => {
            const root = document.documentElement;
            let saved = "system";
            try {
                const candidate = window.localStorage?.getItem("ems-theme");
                if (candidate === "light" || candidate === "dark" || candidate === "system") saved = candidate;
            } catch { /* Storage can be disabled; continue with the system preference. */ }
            let prefersDark = false;
            try { prefersDark = window.matchMedia?.("(prefers-color-scheme: dark)").matches === true; } catch { /* Safe light fallback. */ }
            const resolved = saved === "system" ? (prefersDark ? "dark" : "light") : saved;
            root.dataset.theme = resolved;
            root.classList.toggle("dark", resolved === "dark");
        })();
    </script>
</head>
<body class="app-body min-h-full antialiased">
<div class="min-h-screen">
    @if (authenticated)
    {
        <aside id="sidebar" class="sidebar fixed inset-y-0 left-0 z-40 flex w-72 -translate-x-full flex-col transition-transform lg:translate-x-0">
            <a asp-page="/Index" class="brand-lockup">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 32 32" fill="none"><path d="M18.2 3.5 7.4 17.2h7.7l-1.3 11.3 10.8-15h-7.8l1.4-10Z" fill="currentColor" stroke="currentColor" stroke-linejoin="round"/></svg>
                </span>
                <span class="min-w-0"><span class="brand-name">ENERGY<span>OS</span></span><span class="brand-caption">Energy intelligence platform</span></span>
            </a>
            <div class="sidebar-workspace">
                <span class="workspace-indicator"></span>
                <span><span class="block text-xs font-semibold">Workspace</span><span class="block text-[11px] opacity-70">Residential energy</span></span>
                <span class="ml-auto text-xs opacity-60">⌄</span>
            </div>
            <nav class="sidebar-nav flex-1 space-y-7 overflow-y-auto px-4 py-6" aria-label="Main navigation">
                <div>
                    <p class="nav-heading">Workspace</p>
                    <a asp-page="/Index" class="nav-link @(currentPath == "/" ? "nav-link-active" : "")"><span class="nav-icon" aria-hidden="true">⌂</span> Overview</a>
                </div>
                <div>
                    <p class="nav-heading">Energy operations</p>
                    <a asp-page="/Devices/Index" class="nav-link @(currentPath.StartsWith("/Devices") ? "nav-link-active" : "")"><span class="nav-icon" aria-hidden="true">▦</span> Device inventory</a>
                    <a asp-page="/Alerts/Index" class="nav-link @(currentPath.StartsWith("/Alerts") ? "nav-link-active" : "")"><span class="nav-icon" aria-hidden="true">◉</span> Alerts &amp; notifications</a>
                </div>
                <div>
                    <p class="nav-heading">Administration</p>
                    <a asp-page="/Settings/Index" class="nav-link @(currentPath.StartsWith("/Settings") ? "nav-link-active" : "")"><span class="nav-icon" aria-hidden="true">⚙</span> Settings</a>
                    <a asp-page="/Account/Profile" class="nav-link @(currentPath.StartsWith("/Account/Profile") ? "nav-link-active" : "")"><span class="nav-icon" aria-hidden="true">◎</span> Account security</a>
                    @if (User.IsInRole("Administrator"))
                    {
                        <a asp-page="/Households/Create" class="nav-link @(currentPath.StartsWith("/Households/Create") ? "nav-link-active" : "")"><span class="nav-icon" aria-hidden="true">＋</span> Create household</a>
                        <a asp-page="/Households/Users" class="nav-link @(currentPath.StartsWith("/Households/Users") ? "nav-link-active" : "")"><span class="nav-icon" aria-hidden="true">♙</span> Household users</a>
                    }
                </div>
            </nav>
            <div class="sidebar-footer">
                <div class="sidebar-status">
                    <span class="status-orb"></span>
                    <span class="min-w-0"><span class="block text-xs font-semibold">Platform services</span><span class="block text-[11px] opacity-70">Telemetry integration pending</span></span>
                </div>
                <p class="mt-4 px-2 text-[10px] tracking-wide opacity-50">ENERGYOS · RESIDENTIAL MANAGEMENT</p>
            </div>
        </aside>
    }

    <div class="@(authenticated ? "lg:pl-72" : "")">
        @if (authenticated)
        {
            <header class="app-header sticky top-0 z-30 flex h-[76px] items-center justify-between px-4 md:px-8">
                <div class="flex min-w-0 items-center gap-3">
                    <button id="sidebar-toggle" class="icon-button lg:hidden" type="button" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false">☰</button>
                    <div class="min-w-0"><p class="hidden text-[11px] font-semibold uppercase tracking-[.16em] text-slate-500 sm:block">Energy intelligence</p><h1 class="truncate text-base font-semibold">@pageTitle</h1></div>
                </div>
                <div class="flex items-center gap-2 md:gap-3">
                    @if (ViewData["Households"] is IReadOnlyList<HouseholdOption> households && households.Count > 0)
                    {
                        <form method="get" class="hidden sm:block">
                            @if (Context.Request.Query.TryGetValue("search", out var search)) { <input type="hidden" name="search" value="@search" /> }
                            <label class="sr-only" for="household-select">Selected household</label>
                            <select id="household-select" name="householdId" class="control-select" onchange="this.form.submit()">
                                @foreach (var household in households)
                                {
                                    var selectedId = ViewData["SelectedHouseholdId"] as int?;
                                    <option value="@household.Id" selected="@(selectedId == household.Id)">@household.Code · @household.Name</option>
                                }
                            </select>
                        </form>
                    }
                    <button id="theme-toggle" class="icon-button theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch theme"><span aria-hidden="true">◐</span></button>
                    <a asp-page="/Alerts/Index" class="icon-button notification-button" aria-label="Notifications" title="Notifications"><span aria-hidden="true">♧</span></a>
                    <span class="user-identity hidden max-w-44 truncate text-xs md:block">@User.Identity?.Name</span>
                    <form method="post" asp-page="/Account/Logout"><button type="submit" class="signout-button">Sign out</button></form>
                </div>
            </header>
        }
        <main class="app-main mx-auto max-w-[1680px] px-4 py-7 md:px-8 md:py-9 @(authenticated ? "" : "auth-main min-h-screen")">@RenderBody()</main>
    </div>
</div>
<div id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-slate-950/60 backdrop-blur-sm lg:hidden"></div>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>