@page
@model EnergyManagement.Api.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<div class="mx-auto mt-16 max-w-md rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
    <h1 class="text-2xl font-semibold text-slate-900">Reset your password</h1>
    @if (Model.RequestSubmitted)
    {
        <p class="mt-4 text-sm text-slate-600">If the address belongs to an eligible account, a password-reset link will be sent.</p>
    }
    else
    {
        <p class="mt-2 text-sm text-slate-600">Enter your account email address.</p>
        <form method="post" class="mt-6 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-700"></div>
            <label asp-for="Input.Email" class="block text-sm font-medium text-slate-700">Email</label>
            <input asp-for="Input.Email" autocomplete="email" class="w-full rounded-lg border border-slate-300 px-3 py-2" />
            <span asp-validation-for="Input.Email" class="text-sm text-red-700"></span>
            <button type="submit" class="w-full rounded-lg bg-slate-900 px-4 py-2.5 font-medium text-white">Send reset link</button>
        </form>
    }
    <a asp-page="/Account/Login" class="mt-5 inline-block text-sm font-medium text-slate-700 underline">Back to sign in</a>
</div>
