@page
@model EnergyManagement.Api.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<div class="auth-card">
    <div class="auth-brand"><span class="auth-brand-mark" aria-hidden="true">ϟ</span><span>ENERGY<span class="text-violet-600">OS</span></span></div>
    <p class="eyebrow">Account recovery</p>
    <h1 class="mt-2">Reset your password</h1>
    @if (Model.RequestSubmitted)
    {
        <p class="auth-description mt-3">If the address belongs to an eligible account, a password-reset link will be sent.</p>
    }
    else
    {
        <p class="auth-description mt-3">Enter your account email address and we’ll send instructions to reset your password.</p>
        <form method="post" class="mt-7 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-rose-700"></div>
            <div>
                <label asp-for="Input.Email" class="field-label">Email address</label>
                <input asp-for="Input.Email" type="email" autocomplete="email" class="control-input mt-2 w-full" placeholder="you@example.com" />
                <span asp-validation-for="Input.Email" class="mt-1 block text-xs text-rose-600"></span>
            </div>
            <button type="submit" class="primary-button w-full">Send reset link</button>
        </form>
    }
    <a asp-page="/Account/Login" class="secondary-button mt-6 w-full">← Back to sign in</a>
</div>
