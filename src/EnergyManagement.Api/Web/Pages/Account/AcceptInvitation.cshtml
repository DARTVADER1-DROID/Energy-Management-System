@page
@model EnergyManagement.Api.Web.Pages.Account.AcceptInvitationModel
@{
    ViewData["Title"] = "Accept invitation";
}
<div class="mx-auto mt-16 max-w-xl rounded-xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Household invitation</p>
    <h1 class="mt-2 text-2xl font-semibold">Join @Model.Invitation?.HouseholdName</h1>
    @if (Model.Invitation is not null)
    {
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">This invitation is for <strong>@Model.Invitation.Email</strong> as a <strong>@Model.Invitation.Role</strong>. It expires @Model.Invitation.ExpiresAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm").</p>
    }
    <form method="post" class="mt-6 space-y-4">
        <input type="hidden" asp-for="Input.Token" />
        <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>
        @if (Model.CanAcceptAsSignedInUser)
        {
            <p class="text-sm text-slate-600 dark:text-slate-300">You are signed in with the invited email address. Accept to add this household to your account.</p>
            <button type="submit" class="primary-button w-full">Accept invitation</button>
        }
        else if (Model.ExistingAccount)
        {
            <p class="text-sm text-slate-600 dark:text-slate-300">An account already exists for this email. Sign in with that account, then open this invitation link again.</p>
            <a asp-page="/Account/Login" asp-route-returnUrl="@Url.Page("/Account/AcceptInvitation", new { token = Model.Input.Token })" class="primary-button inline-flex">Sign in to accept</a>
        }
        else
        {
            <p class="text-sm text-slate-600 dark:text-slate-300">Create your account to accept the invitation. The invitation link verifies this email address.</p>
            <div>
                <label asp-for="Password" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Create password</label>
                <input asp-for="Password" autocomplete="new-password" class="control-input mt-1 w-full" />
                <span asp-validation-for="Password" class="text-xs text-rose-600"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Confirm password</label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" class="control-input mt-1 w-full" />
                <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-600"></span>
            </div>
            <button type="submit" class="primary-button w-full">Create account and join</button>
        }
    </form>
</div>
