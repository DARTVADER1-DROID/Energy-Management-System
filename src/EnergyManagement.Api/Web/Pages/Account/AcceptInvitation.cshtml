@page
@model EnergyManagement.Api.Web.Pages.Account.AcceptInvitationModel
@{
    ViewData["Title"] = "Accept invitation";
}
<div class="auth-card max-w-xl">
    <div class="auth-brand"><span class="auth-brand-mark" aria-hidden="true">ϟ</span><span>ENERGY<span class="text-violet-600">OS</span></span></div>
    <p class="eyebrow">Household invitation</p>
    <h1 class="mt-2">Join @Model.Invitation?.HouseholdName</h1>
    @if (Model.Invitation is not null)
    {
        <p class="auth-description mt-3">This invitation is for <strong>@Model.Invitation.Email</strong> as a <strong>@Model.Invitation.Role</strong>. It expires @Model.Invitation.ExpiresAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm").</p>
    }
    <form method="post" class="mt-6 space-y-4">
        <input type="hidden" asp-for="Input.Token" />
        <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>
        @if (Model.CanAcceptAsSignedInUser)
        {
            <p class="auth-description">You are signed in with the invited email address. Accept to add this household to your account.</p>
            <button type="submit" class="primary-button w-full">Accept invitation</button>
        }
        else if (Model.ExistingAccount)
        {
            <p class="auth-description">An account already exists for this email. Sign in with that account, then open this invitation link again.</p>
            <a asp-page="/Account/Login" asp-route-returnUrl="@Url.Page("/Account/AcceptInvitation", new { token = Model.Input.Token })" class="primary-button w-full">Sign in to accept</a>
        }
        else
        {
            <p class="auth-description">Create your account to accept the invitation. The invitation link verifies this email address.</p>
            <div>
                <label asp-for="Password" class="field-label">Create password</label>
                <input asp-for="Password" type="password" autocomplete="new-password" class="control-input mt-2 w-full" placeholder="Create a password" />
                <span asp-validation-for="Password" class="mt-1 block text-xs text-rose-600"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="field-label">Confirm password</label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="control-input mt-2 w-full" placeholder="Enter it again" />
                <span asp-validation-for="ConfirmPassword" class="mt-1 block text-xs text-rose-600"></span>
            </div>
            <button type="submit" class="primary-button w-full">Create account and join</button>
        }
    </form>
</div>
