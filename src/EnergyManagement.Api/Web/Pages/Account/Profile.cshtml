@page
@model EnergyManagement.Api.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Account security";
}
<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <p class="eyebrow">Account</p>
        <h2 class="page-heading">Account security</h2>
        <p class="mt-1 text-sm text-slate-500">Review your sign-in identity and authentication protections.</p>
    </div>
    <a asp-page="/Settings/Index" class="secondary-button">Back to settings</a>
</div>

<div class="mt-7 grid gap-5 xl:grid-cols-2">
    <section class="panel p-6">
        <p class="eyebrow">Identity</p>
        <h3 class="mt-1 text-lg font-semibold">Sign-in account</h3>
        <dl class="mt-5 divide-y divide-slate-100 text-sm dark:divide-slate-800">
            <div class="flex items-center justify-between gap-4 py-3">
                <dt class="text-slate-500">Email address</dt>
                <dd class="break-all text-right font-medium">@Model.Email</dd>
            </div>
            <div class="flex items-center justify-between gap-4 py-3">
                <dt class="text-slate-500">Email status</dt>
                <dd class="font-medium">@(Model.EmailConfirmed ? "Verified" : "Not verified")</dd>
            </div>
            <div class="flex items-center justify-between gap-4 py-3">
                <dt class="text-slate-500">Account access</dt>
                <dd class="font-medium">@(Model.IsAdministrator ? "Administrator" : "Household account")</dd>
            </div>
        </dl>
    </section>

    <section class="panel p-6">
        <p class="eyebrow">Multi-factor authentication</p>
        <h3 class="mt-1 text-lg font-semibold">Authenticator app</h3>
        @if (Model.TwoFactorEnabled)
        {
            <span class="status-pill status-success mt-4">Enabled</span>
            <p class="mt-3 text-sm text-slate-500">Your account requires an authenticator code during sign-in.</p>
            <div class="mt-5 rounded-xl bg-slate-50 p-4 dark:bg-slate-800/60">
                <p class="text-sm font-semibold">Recovery codes remaining</p>
                <p class="mt-1 text-2xl font-semibold">@Model.RecoveryCodesRemaining <span class="text-sm font-normal text-slate-500">of 10</span></p>
                @if (Model.RecoveryCodesRemaining <= 2)
                {
                    <p class="mt-2 text-xs text-amber-700 dark:text-amber-300">Only a few recovery codes remain. Store your original codes securely and contact your household administrator if you have lost access.</p>
                }
                else
                {
                    <p class="mt-2 text-xs text-slate-500">Each recovery code can be used once. Keep unused codes somewhere private and secure.</p>
                }
            </div>
            <form method="post" asp-page-handler="RegenerateRecoveryCodes" class="mt-4"
                  onsubmit="return confirm('Regenerate all recovery codes? Previously issued codes will stop working.');">
                <button type="submit" class="secondary-button">Regenerate recovery codes</button>
            </form>
        }
        else
        {
            <span class="status-pill status-warning mt-4">Not enabled</span>
            <p class="mt-3 text-sm text-slate-500">Use an authenticator app to add a second sign-in factor.</p>
            @if (Model.IsAdministrator)
            {
                <p class="mt-3 rounded-lg bg-amber-50 p-3 text-xs leading-5 text-amber-900 dark:bg-amber-950/40 dark:text-amber-200">Administrator accounts must enable MFA before accessing protected areas of the system.</p>
            }
            <a asp-page="/Account/EnableMfa" class="primary-button mt-5 inline-flex">Set up authenticator</a>
        }
    </section>
</div>

@if (Model.GeneratedRecoveryCodes.Count > 0)
{
    <section class="mt-5 rounded-xl border border-amber-300 bg-amber-50 p-6 dark:border-amber-900 dark:bg-amber-950/30">
        <h3 class="font-semibold text-amber-950 dark:text-amber-100">Save your new recovery codes now</h3>
        <p class="mt-2 text-sm leading-6 text-amber-900 dark:text-amber-200">These ten codes are shown only in this response. All previously issued recovery codes have been invalidated. Store these codes in a secure location.</p>
        <div class="mt-4 grid gap-2 sm:grid-cols-2">
            @foreach (var code in Model.GeneratedRecoveryCodes)
            {
                <code class="rounded-lg bg-white px-3 py-2 text-sm font-semibold text-slate-900 dark:bg-slate-900 dark:text-slate-100">@code</code>
            }
        </div>
    </section>
}

<section class="panel mt-5 p-6">
    <p class="eyebrow">Session protection</p>
    <h3 class="mt-1 text-lg font-semibold">Automatic sign-out</h3>
    <p class="mt-2 text-sm leading-6 text-slate-500">Your session expires after 15 minutes of inactivity and has an eight-hour maximum lifetime. Sessions are not persistent across browser restarts.</p>
</section>
