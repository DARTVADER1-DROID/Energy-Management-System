@page
@model EnergyManagement.Api.Web.Pages.Account.ReauthenticateModel
@{
    ViewData["Title"] = "Confirm your identity";
}
<div class="auth-card">
    <div class="auth-brand"><span class="auth-brand-mark" aria-hidden="true">ϟ</span><span>ENERGY<span class="text-violet-600">OS</span></span></div>
    <p class="eyebrow">Security check</p>
    <h1 class="mt-2">Confirm your identity</h1>
    <p class="auth-description mt-2">This action requires a recent sign-in. Confirm your password to continue.</p>
    <form method="post" class="mt-7 space-y-4">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>
        <div>
            <label asp-for="Password" class="field-label">Password</label>
            <input asp-for="Password" type="password" autocomplete="current-password" class="control-input mt-2 w-full" autofocus placeholder="Enter your password" />
            <span asp-validation-for="Password" class="mt-1 block text-xs text-rose-600"></span>
        </div>
        <button type="submit" class="primary-button w-full">Verify and continue</button>
    </form>
</div>
