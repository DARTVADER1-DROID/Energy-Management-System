@page
@model EnergyManagement.Api.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}
<div class="auth-card">
    <div class="auth-brand"><span class="auth-brand-mark" aria-hidden="true">ϟ</span><span>ENERGY<span class="text-violet-600">OS</span></span></div>
    <p class="eyebrow">Account recovery</p>
    <h1 class="mt-2">Choose a new password</h1>
    <p class="auth-description mt-2">Create a strong password with at least 12 characters.</p>
    <form method="post" class="mt-7 space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-sm text-rose-700"></div>
        <input asp-for="Input.Email" type="hidden" />
        <input asp-for="Input.Code" type="hidden" />
        <div>
            <label asp-for="Input.Password" class="field-label">New password</label>
            <input asp-for="Input.Password" type="password" autocomplete="new-password" class="control-input mt-2 w-full" placeholder="Create a new password" />
            <span asp-validation-for="Input.Password" class="mt-1 block text-xs text-rose-600"></span>
        </div>
        <div>
            <label asp-for="Input.ConfirmPassword" class="field-label">Confirm new password</label>
            <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" class="control-input mt-2 w-full" placeholder="Enter it again" />
            <span asp-validation-for="Input.ConfirmPassword" class="mt-1 block text-xs text-rose-600"></span>
        </div>
        <button type="submit" class="primary-button w-full">Update password</button>
    </form>
</div>
