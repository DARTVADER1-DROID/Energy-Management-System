@page
@model EnergyManagement.Api.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}
<div class="mx-auto mt-16 max-w-md rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
    <h1 class="text-2xl font-semibold text-slate-900">Choose a new password</h1>
    <form method="post" class="mt-6 space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-700"></div>
        <input asp-for="Input.Email" type="hidden" />
        <input asp-for="Input.Code" type="hidden" />
        <div>
            <label asp-for="Input.Password" class="block text-sm font-medium text-slate-700">New password</label>
            <input asp-for="Input.Password" autocomplete="new-password" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
            <span asp-validation-for="Input.Password" class="text-sm text-red-700"></span>
        </div>
        <div>
            <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-slate-700">Confirm password</label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-sm text-red-700"></span>
        </div>
        <button type="submit" class="w-full rounded-lg bg-slate-900 px-4 py-2.5 font-medium text-white">Update password</button>
    </form>
</div>
