@page
@model EnergyManagement.Api.Web.Pages.Account.TwoFactorLoginModel
@{
    ViewData["Title"] = "Authenticator verification";
}
<div class="mx-auto mt-16 max-w-md rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
    <h1 class="text-2xl font-semibold text-slate-900">Verify your sign-in</h1>
    <p class="mt-2 text-sm text-slate-600">Enter an authenticator code or a single-use recovery code.</p>
    <form method="post" class="mt-6 space-y-4">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-700"></div>
        <div>
            <label asp-for="Input.Code" class="block text-sm font-medium text-slate-700">Authenticator code</label>
            <input asp-for="Input.Code" inputmode="numeric" autocomplete="one-time-code" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
        </div>
        <div>
            <label asp-for="Input.RecoveryCode" class="block text-sm font-medium text-slate-700">Recovery code (instead)</label>
            <input asp-for="Input.RecoveryCode" autocomplete="off" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
        </div>
        <button type="submit" class="w-full rounded-lg bg-slate-900 px-4 py-2.5 font-medium text-white">Verify</button>
    </form>
</div>
