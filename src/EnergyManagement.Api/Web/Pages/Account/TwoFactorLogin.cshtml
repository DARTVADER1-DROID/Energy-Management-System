@page
@model EnergyManagement.Api.Web.Pages.Account.TwoFactorLoginModel
@{
    ViewData["Title"] = "Two-factor sign-in unavailable";
}
<div class="mx-auto mt-16 max-w-md rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
    <h1 class="text-2xl font-semibold text-slate-900">Two-factor sign-in is disabled</h1>
    <p class="mt-3 text-sm text-slate-600">Sign in using your email address and password.</p>
    <a asp-page="/Account/Login" class="primary-button mt-6 inline-flex">Return to sign in</a>
</div>
