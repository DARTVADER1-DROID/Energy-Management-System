@page
@model EnergyManagement.Api.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="mx-auto mt-16 max-w-md rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
    <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Energy Management System</p>
    <h1 class="mt-2 text-2xl font-semibold text-slate-900">Sign in</h1>
    <p class="mt-2 text-sm text-slate-600">Use the account created by your household administrator.</p>
    <form method="post" class="mt-6 space-y-5">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-700"></div>
        <div>
            <label asp-for="Input.Email" class="block text-sm font-medium text-slate-700">Email</label>
            <input asp-for="Input.Email" autocomplete="username" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
            <span asp-validation-for="Input.Email" class="text-sm text-red-700"></span>
        </div>
        <div>
            <label asp-for="Input.Password" class="block text-sm font-medium text-slate-700">Password</label>
            <input asp-for="Input.Password" autocomplete="current-password" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" />
            <span asp-validation-for="Input.Password" class="text-sm text-red-700"></span>
        </div>
        <button type="submit" class="w-full rounded-lg bg-slate-900 px-4 py-2.5 font-medium text-white">Sign in</button>
    </form>
    <a asp-page="/Account/ForgotPassword" class="mt-4 inline-block text-sm text-slate-600 underline">Forgot password?</a>
</div>
