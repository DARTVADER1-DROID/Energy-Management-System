@page
@model EnergyManagement.Api.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="auth-card">
    <div class="auth-brand"><span class="auth-brand-mark" aria-hidden="true">ϟ</span><span>ENERGY<span class="text-violet-600">OS</span></span></div>
    <p class="eyebrow">Welcome back</p>
    <h1 class="mt-2">Sign in to your workspace</h1>
    <p class="auth-description mt-2">Access your household energy operations and connected devices.</p>
    @if (TempData["StatusMessage"] is string status)
    {
        <div class="mt-5 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-200">@status</div>
    }
    <form method="post" class="mt-7 space-y-5">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="rounded-lg text-sm text-rose-700 dark:text-rose-300"></div>
        <div>
            <label asp-for="Input.Email" class="field-label">Email address</label>
            <input asp-for="Input.Email" type="email" autocomplete="username" class="control-input mt-2 w-full" placeholder="you@example.com" />
            <span asp-validation-for="Input.Email" class="mt-1 block text-xs text-rose-600"></span>
        </div>
        <div>
            <div class="flex items-center justify-between gap-3"><label asp-for="Input.Password" class="field-label">Password</label><a asp-page="/Account/ForgotPassword" class="text-xs font-semibold text-violet-700 hover:text-violet-900 dark:text-violet-300">Forgot password?</a></div>
            <input asp-for="Input.Password" type="password" autocomplete="current-password" class="control-input mt-2 w-full" placeholder="Enter your password" />
            <span asp-validation-for="Input.Password" class="mt-1 block text-xs text-rose-600"></span>
        </div>
        <button type="submit" class="primary-button w-full py-3">Sign in <span aria-hidden="true">→</span></button>
    </form>
    <p class="mt-7 border-t border-slate-200 pt-5 text-center text-xs leading-5 text-slate-500 dark:border-slate-800">Secure access for authorized household members.</p>
</div>
