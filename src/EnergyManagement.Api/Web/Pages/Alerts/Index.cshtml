@page
@model Alerts.IndexModel
@{
    ViewData["Title"] = "Alerts & notifications";
}
<div><p class="eyebrow">Operations</p><h2 class="page-heading">Alerts &amp; notifications</h2><p class="mt-1 text-sm text-slate-500">A central place for household warnings and operational events.</p></div>
<section class="panel mt-7 p-8">
    <div class="mx-auto max-w-lg py-8 text-center">
        <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-blue-50 text-2xl text-blue-600 dark:bg-blue-950">◉</div>
        <h3 class="mt-4 text-lg font-semibold">Notification centre foundation</h3>
        <p class="mt-2 text-sm leading-6 text-slate-500">The global notification experience is planned with unread state, acknowledgement and history. It will become active when alert generation and delivery are implemented.</p>
        <span class="status-pill status-neutral mt-4">Not yet connected to alert events</span>
    </div>
</section>
